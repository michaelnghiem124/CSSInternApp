# The app reads .env from this folder first, then from the folder above it.
# Provide ONE of the two model keys. Never commit a real .env.

# Option A: Claude (Sonnet 5.5 matchmaker + Haiku 5.5 profile reader). Used when present.
ANTHROPIC_API_KEY=

# Option B: the MGT 409 course key, gpt-6-luna via Portkey. Used when ANTHROPIC_API_KEY is empty.
PORTKEY_API_KEY=

# Admin sign-in for the Program Chair. Don't type these by hand: run
#   .venv/bin/python -m scripts.set_admin_password
# which asks for a username and password and saves only a scrypt hash here.
# Admin sign-in stays disabled until both are set.
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=
# Signs sign-in cookies. Optional locally (one is generated in data/.session_secret).
SESSION_SECRET=

# Optional overrides
# MODEL_PROVIDER=anthropic            # or portkey, to force one
# ANTHROPIC_MATCH_MODEL=claude-sonnet-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# DAILY_TOKEN_BUDGET=2000000
# RATE_LIMIT_PER_MINUTE=6
# ADMIN_NAME=Michael Nghiem
# ADMIN_TITLE=Chair, Intern Cyber Security Program
